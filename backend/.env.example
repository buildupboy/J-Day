# 백엔드 서버가 실행될 포트 번호
PORT=3001

# 프론트엔드(React + Vite) 주소, CORS 허용용
FRONTEND_URL=http://localhost:5173

# 서버 시간대, 한국 시간 기준으로 오늘·내일을 계산
TZ=Asia/Seoul

# OpenAI 콘솔에서 발급받은 API 키 (절대 GitHub에 올리지 말 것)
OPENAI_API_KEY=

# 일정 해석·작업량 추정에 쓸 LLM 모델명 (빠른 경량 모델 권장)
OPENAI_MODEL=

# (선택) 음성 인식 백업용 모델명, Web Speech API만 쓰면 비워 둬도 됨
OPENAI_TRANSCRIBE_MODEL=

# JSON Schema 구조화 출력을 지원하는 모델 사용. 모델 호출 제한 시간(밀리초)
LLM_TIMEOUT_MS=30000

# 친구의 rescheduler 구현을 병합한 뒤에만 true로 변경
# false: Task와 schedulerRequests를 db.json에 저장하고 배치 대기 응답
VOICE_SCHEDULER_ENABLED=false
